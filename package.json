{
  "name": "dermatologia-monorepo",
  "private": true,
  "scripts": {
    "postinstall": "pnpm --filter @derma/shared build",
    "dev": "pnpm --parallel --filter api --filter web run dev",
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm --filter shared build && pnpm --filter api build && pnpm --filter web build",
    "db:generate": "pnpm --filter api prisma:generate",
    "db:push": "pnpm --filter api prisma:push",
    "db:migrate": "pnpm --filter api prisma:migrate",
    "db:seed": "pnpm --filter api prisma:seed",
    "lint": "pnpm -r lint"
  },
  "packageManager": "pnpm@9.14.2",
  "engines": {
    "node": "20.x"
  }
}
