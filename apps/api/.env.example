PORT=4000
NODE_ENV=development

DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

JWT_SECRET=change_me_long_random
FRONTEND_URL=http://localhost:3000

AI_PROVIDER=google
GOOGLE_GENAI_API_KEY=
# Id exacto de la API (minúsculas). Gemma 3n E2B IT → gemma-3n-e2b-it · Gemini → gemini-2.0-flash
GOOGLE_GENAI_MODEL=gemma-3n-e2b-it
AI_TEMPERATURE=0.4

# Si existe `.env` en la raíz del monorepo, esas variables de correo tienen prioridad sobre este archivo.
# none | resend | smtp | gmail  (gmail = SMTP con smtp.gmail.com por defecto)
EMAIL_PROVIDER=none
# Remitente visible. Con Resend: dominio verificado. Con Gmail/SMTP: suele ser la misma cuenta que SMTP_USER.
EMAIL_FROM=
ADMIN_NOTIFICATION_EMAIL=
RESEND_API_KEY=
# SMTP / Gmail (cuenta con 2FA + contraseña de aplicación en Google)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
# Opcional: cabecera Reply-To
EMAIL_REPLY_TO=

WHATSAPP_NUMBER=5491112345678
